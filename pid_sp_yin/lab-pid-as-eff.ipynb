    "import numpy as np\n",
    "\n",
    "def scatter_colored_points(first_stg_nodes, node_vals, mode=\"mpl\", highlight_min=True):\n",
    "    \"\"\"\n",
    "    mode: 'mpl' 或 'plotly'\n",
    "    返回: (best_point, best_value)\n",
    "    \"\"\"\n",
    "    pts = np.asarray(first_stg_nodes, dtype=float)\n",
    "    vals = np.asarray(node_vals, dtype=float).ravel()\n",
